# Container image to run.
VLLM_IMAGE=vllm/vllm-openai:v0.26.0

# Localhost port and model identifier exposed through the OpenAI-compatible API.
VLLM_PORT=8000
SERVED_MODEL_NAME=Qwen3-32B-AWQ

# Set this to the number of GPUs across which the model should be sharded.
TENSOR_PARALLEL_SIZE=1

# Reduce these if the model does not fit in available GPU memory.
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
